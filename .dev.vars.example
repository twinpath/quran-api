# ==============================================================================
# CLOUDFLARE WORKERS / PAGES ENVIRONMENT VARIABLES CLASSIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BUILD VARIABLE (Public / Injected during Next.js Build)
#    Configured in CI/CD Environment Variables (Cloudflare Dashboard / .env) during `pnpm build`.
#    Injected into the client-side JavaScript bundle.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. RUNTIME VARIABLE (Non-Sensitive Server Configuration)
#    Configured under `vars` in wrangler.jsonc or non-secret Environment Variables in Cloudflare.
#    Read by the Worker server-side during incoming HTTP requests.
# ------------------------------------------------------------------------------
NEXTJS_ENV=development
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
TELEGRAM_BOT_USERNAME=QuranApiAlertsBot
EMAIL_PROVIDER=auto
RESEND_FROM_EMAIL=alerts@quran.dyzulk.com
BREVO_FROM_EMAIL=alerts@quran.dyzulk.com

# ------------------------------------------------------------------------------
# 3. RUNTIME SECRET (Sensitive / Encrypted Server Credentials)
#    Configured using `wrangler secret put <KEY>` or Secrets in Cloudflare Dashboard.
#    For local development, stored in `.dev.vars`. Strictly confidential!
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET=<auto-generated-by-pnpm-generate-vars>
GOOGLE_CLIENT_SECRET=your-google-client-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
RESEND_API_KEY=re_123456789
BREVO_API_KEY=xkeysib-123456789

# ------------------------------------------------------------------------------
# 4. BUILD SECRET (Sensitive Build-Time Credentials)
#    (None in this file. Example: NPM_TOKEN for private packages during build)
# ------------------------------------------------------------------------------


